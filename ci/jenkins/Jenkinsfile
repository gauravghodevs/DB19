pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout Verification') {
            steps {
                echo 'SecureOps CI pipeline started'
                sh 'git --version'
                sh 'test -f applications/payment-api/app/main.py'
                sh 'test -f applications/payment-api/requirements.txt'
                sh 'test -f applications/payment-api/requirements-dev.txt'
                sh 'test -f applications/payment-api/tests/test_api.py'
                echo 'Payment API source and test files verified'
            }
        }

        stage('Workspace Verification') {
            steps {
                sh 'pwd'
                sh 'git status --short || true'
            }
        }

        stage('Automated API Tests') {
            steps {
                dir('applications/payment-api') {
                    sh '''
                        python3 --version
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/python -m pip install -r requirements-dev.txt
                        .venv/bin/python -m pytest -v
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'SecureOps CI verification and API tests completed successfully'
        }
        failure {
            echo 'SecureOps CI failed; inspect the stage logs'
        }
        always {
            dir('applications/payment-api') {
                sh 'rm -rf .venv'
            }
        }
    }
}
