pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout and Environment Verification') {
            steps {
                checkout scm

                sh '''
                    set -eu

                    echo "===== Runtime versions ====="
                    git --version
                    python3 --version
                    bash --version | head -1

                    echo
                    echo "===== Verify required files ====="
                    test -f applications/payment-api/app/main.py
                    test -f applications/payment-api/requirements.txt
                    test -f applications/payment-api/requirements-dev.txt
                    test -f applications/payment-api/tests/test_api.py
                    test -f kubernetes/base/kustomization.yaml
                    test -f scripts/quality-gate.sh
                    test -f scripts/verify-payment-api.sh
                    test -f scripts/validate-repo.sh

                    echo
                    echo "===== Checked out revision ====="
                    git rev-parse --short HEAD
                    git status --short
                '''
            }
        }

        stage('Shell Syntax Validation') {
            steps {
                sh '''
                    set -eu

                    echo "Checking shell script syntax..."

                    find scripts -type f -name '*.sh' -print |
                    while IFS= read -r script; do
                        bash -n "$script"
                        echo "PASS: $script"
                    done

                    echo "Shell syntax validation passed."
                '''
            }
        }

        stage('Automated API Tests') {
            steps {
                dir('applications/payment-api') {
                    sh '''
                        set -eu

                        python3 --version
                        python3 -m venv .venv
                        .venv/bin/python -m pip install \
                            -r requirements-dev.txt
                        .venv/bin/python -m pytest -v
                    '''
                }
            }
        }

        stage('Code Quality Gate') {
            steps {
                sh '''
                    set -eu
                    scripts/quality-gate.sh
                '''
            }
        }

        stage('Kubernetes Manifest Validation') {
            steps {
                script {
                    if (sh(
                        script: 'command -v kubectl >/dev/null 2>&1',
                        returnStatus: true
                    ) == 0) {
                        sh '''
                            set -eu

                            kubectl kustomize kubernetes/base \
                                > secureops-rendered-manifests.yaml

                            grep -q '^kind: Deployment$' \
                                secureops-rendered-manifests.yaml
                            grep -q '^kind: Service$' \
                                secureops-rendered-manifests.yaml
                            grep -q 'name: payment-api' \
                                secureops-rendered-manifests.yaml

                            echo "Kustomize rendering and resource checks passed."
                        '''
                    } else {
                        echo 'SKIPPED: kubectl is not installed on this Jenkins agent.'
                        echo 'GitHub Actions remains responsible for strict Kubernetes schema validation.'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'SecureOps Jenkins CI completed successfully.'
        }

        failure {
            echo 'SecureOps Jenkins CI failed. Review the failing stage logs.'
        }

        always {
            dir('applications/payment-api') {
                sh '''
                    if [ -d .venv ]; then
                        rm -rf .venv
                    fi
                '''
            }
            sh 'rm -f secureops-rendered-manifests.yaml'
        }
    }
}
